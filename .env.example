# Copy to .env. Never commit real values.
DATABASE_URL=postgresql+psycopg://prodexa:prodexa@localhost:5432/prodexa
REDIS_URL=redis://localhost:6379/0
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Random, at least 32 characters in production (python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:5173
# "production" enables strict startup checks and secure cookies
ENVIRONMENT=development
# hashing (default, lexical) or minilm (needs requirements-ml.txt)
EMBEDDER=hashing
RATE_LIMIT_PER_MINUTE=30
